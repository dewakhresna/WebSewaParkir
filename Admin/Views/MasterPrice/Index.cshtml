@{
    ViewData["Title"] = "Dashboard Parkir Price";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}


<div class="pagetitle">
    <h1>Parkir Price</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="">Home</a></li>
            <li class="breadcrumb-item active">Parkir Price</li>
        </ol>
    </nav>
</div>

<section class="section dashboard">
    <div class="row">
        <div class="col-12">
            <div class="card recent-sales overflow-auto">
                <div class="filter">
                    <div class="icon">
                        <a class="btn btn-success" asp-action="Add" asp-controller="MasterPrice"><i class="bx bx-list-plus me-1"></i> Add Parkir Price</a>
                    </div>
                </div>
                <div class="card-body">
                    <h5 class="card-title">Parkir Price Data</h5>

                    <table class="table table-borderless datatable">
                        <thead>
                            <tr>
                                <th scope="col">No</th>
                                <th scope="col">Price</th>
                                <th scope="col">Duration / Month</th>
                                <th scope="col">Description</th>
                                <th scope="col">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int no = 1;
                                foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@no</td>
                                        <td>@item.Price</td>
                                        <td>@item.Duration</td>
                                        <td>@item.Description</td>
                                        <td>
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn badge bg-warning">Edit</a>
                                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn badge bg-danger">Delete</a>
                                        </td>
                                    </tr>
                                    no++;
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div><!-- End Recent Sales -->
    </div>
</section>