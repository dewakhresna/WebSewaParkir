@{
    ViewData["Title"] = "Dashboard Rental";
    Layout = "~/Views/Shared/_LayoutUser.cshtml";
}


<div class="pagetitle">
    <h1>Car User</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="">Home</a></li>
            <li class="breadcrumb-item active">Car User</li>
        </ol>
    </nav>
</div>

<section class="section dashboard">
    <div class="row">
        <div class="col-12">
            <div class="card recent-sales overflow-auto">
                <div class="filter">
                    <div class="icon">
                        <a class="btn btn-success" asp-action="Add" asp-controller="UserRental"><i class="bx bx-list-plus me-1"></i> Add Rental</a>
                    </div>
                </div>
                <div class="card-body">
                    <h5 class="card-title">Car Rental Data</h5>

                    <table class="table table-borderless datatable">
                        <thead>
                            <tr>
                                <th scope="col">No</th>
                                <th scope="col">Car Name</th>
                                <th scope="col">Car Type</th>
                                <th scope="col">No Police</th>
                                <th scope="col">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int no = 1;
                                foreach (var item in Model)
                                {
                                    <tr>
                                        <th scope="row"><a href="#">@no</a></th>
                                        <td>@item.Kendaraan.Merek</td>
                                        <td>@item.Kendaraan.Tipe</td>
                                        <td>@item.NoPolice</td>
                                        <td>
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn badge bg-warning">Edit</a>
                                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn badge bg-danger">Delete</a>
                                            <a asp-controller="UserSubscriptions" asp-action="Index" asp-route-id="@item.Id" class="btn badge bg-info">Booking</a>
                                        </td>
                                    </tr>
                                    no++;
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>