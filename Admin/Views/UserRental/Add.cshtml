@model Models.Master.MasterRentalModel

@{
    ViewData["Title"] = "Add Your Car";
    Layout = "~/Views/Shared/_LayoutUser.cshtml";
}

<div class="pagetitle">
    <h1>Add Rental</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="">Home</a></li>
            <li class="breadcrumb-item active">Add Car</li>
        </ol>
    </nav>
</div>

<section class="section">
    <div class="row">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Add Rental</h5>

                <form asp-action="Add" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="row mb-3">
                        <label asp-for="IdKendaraan" class="col-sm-2 col-form-label">Car Names</label>
                        <div class="col-sm-10">
                            <select asp-for="IdKendaraan" class="form-select" aria-label="Default select example" required>
                                <option selected>Select CarName</option>
                                @foreach (var item in ViewBag.CarList)
                                {
                                    <option value="@item.Id">@item.Tipe</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label asp-for="NoPolice" class="col-sm-2 col-form-label">No Police</label>
                        <div class="col-sm-10">
                            <input asp-for="NoPolice" class="form-control" required />
                            <span asp-validation-for="NoPolice" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-sm-10 offset-sm-2">
                            <input type="submit" value="Create" class="btn btn-primary" />
                        </div>
                    </div>

                </form>

            </div>
        </div>
    </div>
</section>