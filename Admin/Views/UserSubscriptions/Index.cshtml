@model Models.Master.MasterSubscriptionsModel

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_LayoutUser.cshtml";
}

<div class="container">
    <form asp-controller="UserSubscriptions" asp-action="Add" method="post" enctype="multipart/form-data">
        <input type="hidden" name="CarRentalId" value="@Model.Car.Id" />

        <div class="row">
            <div class="col-lg-12">
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-white border-bottom">
                        <h4 class="mb-0"><i class="bi bi-truck me-2"></i>Payment Form</h4>
                    </div>
                    <div class="card-body">
                        <div class="border-top pt-3">
                            <h5 class="mb-3">Car Information</h5>
                            <div class="card mb-3">
                                <div class="row g-0">
                                    <div class="col-md-8">
                                        <div class="card-body">
                                            <h6 class="card-title">Your Car : @(Model.Kendaraan?.Merek ?? "-")</h6>
                                            <p class="card-text mb-1"><small>Merek: @(Model.Kendaraan?.Tipe ?? "-")</small></p>
                                            <p class="card-text mb-1"><small>No Police: @(Model.Car?.NoPolice ?? "-")</small></p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="border-top pt-3 mt-4">
                            <h5 class="mb-3">Parkir Area</h5>
                            <div class="card mb-3">
                                <div class="row g-0">
                                    <div class="row g-0">
                                        <div class="col-md-12">
                                            <div class="card-body">
                                                <label class="col-sm-2 col-form-label">Parkir Slot</label>
                                                <div class="col-sm-12">
                                                    <select class="form-select" aria-label="Default select example" name="ParkirSlotId" required>
                                                        <option selected>Select Your Slot</option>
                                                        <option value="1">A1</option>
                                                        <option value="2">A2</option>
                                                        <option value="3">A3</option>
                                                    </select>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                             </<div>
                        </div>
                        <div class="border-top pt-3 mt-4">
                            <h5 class="mb-3">Rental</h5>
                            <div class="card mb-3">
                                <div class="row g-0">
                                    <div class="row g-0">
                                        <div class="col-md-12">
                                            <div class="card-body">      
                                                <label class="col-sm-2 col-form-label">Sewa /Month</label>
                                                <div class="col-sm-12">
                                                    <select id="duration-select" asp-for="Time" class="form-select" aria-label="Default select example" required>
                                                        <option selected>Select Month</option>
                                                        @foreach (var item in ViewBag.Price)
                                                        {   
                                                            <option value="@item.Duration" data-price="@item.Price">@item.Description</option>
                                                        }
                                                    </select>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </<div>
                        </div>
                        <!-- Metode Pembayaran -->
                        <div class="border-top pt-3 mt-4">
                            <h5 class="mb-3">Metode Pembayaran</h5>
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <div class="form-check card border p-3">
                                        <input class="form-check-input" type="radio" name="PaymentMethod"
                                               id="method-dana" value="Dana" required>
                                        <label class="form-check-label" for="method-dana">
                                            <div class="d-flex align-items-center">
                                                <img src="/images/DANA.png" class="me-2" width="55">
                                                <div>
                                                    <h6 class="mb-0">Dana</h6>
                                                    <small class="text-muted">0812-3434-5678 a.n. Static Pleasure</small>
                                                </div>
                                            </div>
                                        </label>
                                    </div>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <div class="form-check card border p-3">
                                        <input class="form-check-input" type="radio" name="PaymentMethod"
                                               id="method-bank-bca" value="Bank BCA" required>
                                        <label class="form-check-label" for="method-bank-bca">
                                            <div class="d-flex align-items-center">
                                                <img src="/images/Bank-BCA.png" class="me-2" width="70">
                                                <div>
                                                    <h6 class="mb-0">Transfer Bank BCA</h6>
                                                    <small class="text-muted">377892536 a.n. Static Pleasure</small>
                                                </div>
                                            </div>
                                        </label>
                                    </div>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <div class="form-check card border p-3">
                                        <input class="form-check-input" type="radio" name="PaymentMethod"
                                               id="method-GoPay" value="GoPay" required>
                                        <label class="form-check-label" for="method-GoPay">
                                            <div class="d-flex align-items-center">
                                                <img src="/images/GoPay.png" class="me-2" width="55">
                                                <div>
                                                    <h6 class="mb-0">Go Pay</h6>
                                                    <small class="text-muted">0812-3434-5678 a.n. Static Pleasure</small>
                                                </div>
                                            </div>
                                        </label>
                                    </div>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <div class="form-check card border p-3">
                                        <input class="form-check-input" type="radio" name="PaymentMethod"
                                               id="method-ShoppePay" value="ShoppePay" required>
                                        <label class="form-check-label" for="method-ShoppePay">
                                            <div class="d-flex align-items-center">
                                                <img src="/images/ShopeePay.png" class="me-2" width="55">
                                                <div>
                                                    <h6 class="mb-0">Shoppe Pay</h6>
                                                    <small class="text-muted">0812-3434-5678 a.n. Static Pleasure</small>
                                                </div>
                                            </div>
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- Upload Bukti -->
                        <div class="border-top pt-3 mt-4">
                            <h5 class="mb-3">Upload Bukti Pembayaran</h5>
                            <div class="mb-3">
                                <label class="form-label">File Bukti Transfer</label>
                                <input class="form-control" type="file" name="PaymentProof" id="PaymentProof" required>
                            </div>
                        </div>
                        <div class="border-top pt-3 mt-4">
                            <div class="d-flex justify-content-between fw-bold fs-5">
                                <span>Total Pembayaran</span>
                                <span id="grand-total">Rp</span>
                                <input type="hidden" name="Price" id="Price">
                            </div>
                            <button type="submit" id="btn-sewa" class="btn btn-primary w-100 mt-4 py-2" disabled>
                                <i class="bi bi-check-circle me-2"></i>Sewa
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div><!-- row -->
    </form>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            var btnSewa = $('#btn-sewa');
            var grandTotal = $('#grand-total');
            var inputPrice = $('#Price');
            var durationSelect = $('#duration-select');
            var fileInput = $('#PaymentProof');

            function checkButtonState() {
                var selectedOption = durationSelect.find(':selected');
                var currentPrice = selectedOption.data('price');

                var isPriceValid = currentPrice && currentPrice > 0;

                var isFileUploaded = fileInput.val() !== '';

                if (isPriceValid && isFileUploaded) {
                    btnSewa.prop('disabled', false);
                    btnSewa.removeAttr('disabled');
                } else {
                    btnSewa.prop('disabled', true);
                }
            }

            durationSelect.change(function () {
                var selectedOption = $(this).find(':selected');
                var selectedPrice = selectedOption.data('price');

                if (selectedPrice && selectedPrice > 0) {
                    var formattedPrice = 'Rp ' + parseFloat(selectedPrice).toLocaleString('id-ID');
                    grandTotal.text(formattedPrice);
                    inputPrice.val(selectedPrice);
                } else {
                    grandTotal.text('Rp 0');
                    inputPrice.val(0);
                }

                checkButtonState();
            });

            fileInput.change(function () {
                checkButtonState();
            });
        });
    </script>
}