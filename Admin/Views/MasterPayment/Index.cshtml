@model List<Models.Master.MasterSubscriptionsModel>


@{
    ViewData["Title"] = "Payment Status";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}


<div class="pagetitle">
    <h1>Payment Status</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="">Home</a></li>
            <li class="breadcrumb-item active">Payment Status</li>
        </ol>
    </nav>
</div>

<section class="section dashboard">
    <div class="row">
        <div class="col-12">
            <div class="card recent-sales overflow-auto">
                @* <div class="filter">
                    <div class="icon">
                        <a class="btn btn-success" asp-action="" asp-controller=""><i class="bx bx-list-plus me-1"></i> Add Your Car</a>
                    </div>
                </div> *@
                <div class="card-body">
                    <h5 class="card-title">Payment Status</h5>

                    <table class="table table-borderless datatable">
                        <thead>
                            <tr>
                                <th scope="col">No</th>
                                <th scope="col">Car Name</th>
                                <th scope="col">No Police</th>
                                <th scope="col">Parkir Slot</th>
                                <th scope="col">Start Date</th>
                                <th scope="col">Status</th>
                                <th scope="col">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int no = 1;
                            }
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@no</td>
                                    <td>@item.Car?.Kendaraan.Tipe</td>
                                    <td>@item.Car?.NoPolice</td>
                                    <td>@item.ParkirSlot?.SlotNumber</td>
                                    <td>@item.LastPaymentDate</td>
                                    <td><span class="@{@item.StatusInfo}">@item.StatusText</span></td>
                                    <td>
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn badge bg-primary">More</a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn badge bg-danger">Delete</a>
                                    </td>
                                </tr>
                                no++;
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>